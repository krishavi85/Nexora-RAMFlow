<Window x:Class="Nexora.RAMFlow.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nexora RAMFlow" Height="850" Width="1180" MinHeight="720" MinWidth="980"
        Background="{StaticResource WindowBackground}" WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBackground}" />
            <Setter Property="BorderBrush" Value="{StaticResource CardBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="18" />
            <Setter Property="Margin" Value="0,0,12,12" />
        </Style>
        <Style x:Key="MutedButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#2A3555" />
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="NEXORA RAMFLOW" FontWeight="Bold" FontSize="13" Foreground="{StaticResource Accent}" />
                <TextBlock Text="Virtual Memory Control Center" FontWeight="SemiBold" FontSize="30" Margin="0,3,0,4" />
                <TextBlock Text="Diagnose memory pressure and configure Windows paging safely." Foreground="{StaticResource SecondaryText}" FontSize="14" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="ElevateButton" Style="{StaticResource MutedButton}" Content="Restart as administrator" Click="ElevateButton_Click" />
                <Button Content="Refresh" Click="RefreshButton_Click" />
            </StackPanel>
        </Grid>

        <UniformGrid Grid.Row="1" Columns="4">
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="PHYSICAL RAM" Foreground="{StaticResource SecondaryText}" FontSize="12" FontWeight="Bold" />
                    <TextBlock x:Name="PhysicalUsageText" Text="—" FontSize="28" FontWeight="SemiBold" Margin="0,10,0,4" />
                    <TextBlock x:Name="PhysicalDetailText" Text="Collecting data…" Foreground="{StaticResource SecondaryText}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="VIRTUAL MEMORY" Foreground="{StaticResource SecondaryText}" FontSize="12" FontWeight="Bold" />
                    <TextBlock x:Name="VirtualUsageText" Text="—" FontSize="28" FontWeight="SemiBold" Margin="0,10,0,4" />
                    <TextBlock x:Name="VirtualDetailText" Text="Collecting data…" Foreground="{StaticResource SecondaryText}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="PAGE FILE" Foreground="{StaticResource SecondaryText}" FontSize="12" FontWeight="Bold" />
                    <TextBlock x:Name="PageFileText" Text="—" FontSize="22" FontWeight="SemiBold" Margin="0,10,0,4" TextWrapping="Wrap" />
                    <TextBlock Text="Allocated / currently used" Foreground="{StaticResource SecondaryText}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="WINDOWS DRIVE" Foreground="{StaticResource SecondaryText}" FontSize="12" FontWeight="Bold" />
                    <TextBlock x:Name="DiskText" Text="—" FontSize="22" FontWeight="SemiBold" Margin="0,10,0,4" TextWrapping="Wrap" />
                    <TextBlock x:Name="PressureText" Text="Memory pressure: —" Foreground="{StaticResource SecondaryText}" />
                </StackPanel>
            </Border>
        </UniformGrid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.05*" />
                <ColumnDefinition Width="0.95*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Smart Recommendation" FontSize="20" FontWeight="SemiBold" />
                    <StackPanel Grid.Row="1" Margin="0,16,0,16">
                        <TextBlock Text="Workload profile" Foreground="{StaticResource SecondaryText}" Margin="0,0,0,6" />
                        <StackPanel Orientation="Horizontal">
                            <ComboBox x:Name="WorkloadProfileCombo" />
                            <Button Content="Analyze" Margin="10,0,0,0" Click="AnalyzeButton_Click" />
                        </StackPanel>
                    </StackPanel>
                    <Border Grid.Row="2" Background="#10172A" CornerRadius="10" Padding="18">
                        <StackPanel>
                            <TextBlock x:Name="RecommendationTitle" Text="Run an analysis" FontSize="19" FontWeight="SemiBold" />
                            <TextBlock x:Name="RecommendationSize" Text="" Foreground="{StaticResource Success}" FontSize="24" FontWeight="Bold" Margin="0,12,0,4" />
                            <TextBlock x:Name="RecommendationBody" Text="Select a profile and analyze your system." Foreground="{StaticResource SecondaryText}" TextWrapping="Wrap" LineHeight="21" />
                            <TextBlock x:Name="RecommendationWarning" Text="" Foreground="{StaticResource Warning}" TextWrapping="Wrap" Margin="0,14,0,0" />
                            <StackPanel Orientation="Horizontal" Margin="0,22,0,0">
                                <Button x:Name="ApplyRecommendationButton" Content="Apply recommendation" Click="ApplyRecommendationButton_Click" IsEnabled="False" />
                                <Button Style="{StaticResource MutedButton}" Content="Use Windows managed" Click="UseSystemManagedButton_Click" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource CardStyle}" Margin="0,0,0,12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Top Memory Consumers" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,14" />
                    <ListView Grid.Row="1" x:Name="ProcessListView" Background="#10172A" Foreground="{StaticResource PrimaryText}" BorderThickness="0">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Process" DisplayMemberBinding="{Binding Name}" Width="190" />
                                <GridViewColumn Header="PID" DisplayMemberBinding="{Binding Id}" Width="70" />
                                <GridViewColumn Header="Memory" DisplayMemberBinding="{Binding WorkingSetDisplay}" Width="105" />
                            </GridView>
                        </ListView.View>
                    </ListView>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="3" Background="#10172A" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="10" Padding="12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusBanner" Text="Ready." Foreground="{StaticResource SecondaryText}" TextWrapping="Wrap" />
                <TextBlock Grid.Column="1" x:Name="LastUpdatedText" Text="" Foreground="{StaticResource SecondaryText}" Margin="16,0,0,0" />
            </Grid>
        </Border>
    </Grid>
</Window>
